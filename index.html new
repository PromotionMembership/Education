<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080d25">
<title>Educational Store</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:linear-gradient(-45deg,#080d25,#142b50,#102b45,#171b43);background-size:350% 350%;animation:bgShift 16s ease infinite;color:#fff}
header{text-align:center;padding:32px 10px}
header h1{font-size:clamp(30px,6vw,42px);background:linear-gradient(90deg,#65eaff,#a78bfa,#53e5ce,#65eaff);background-size:250% auto;color:transparent;background-clip:text;animation:titleGlow 5s linear infinite}
header p{color:#c5d2ed}
.container{max-width:1000px;margin:auto;padding:15px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px}
.card{background:linear-gradient(145deg,#1b3157,#172747);border:1px solid #45628f;border-radius:20px;padding:22px;text-align:center;transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease;animation:show .65s both;box-shadow:0 8px 24px #0003}
.card:hover{transform:translateY(-9px) scale(1.02);border-color:#70e9ff;box-shadow:0 16px 38px #0009,0 0 18px #53e5ce33}
.logo{width:72px;height:72px;margin:auto;border-radius:18px;display:block;object-fit:contain;background:#fff;padding:4px;box-shadow:0 6px 18px #0005}
.price{font-size:27px;font-weight:bold;margin:15px}
button{position:relative;overflow:hidden;width:100%;padding:13px;border:0;border-radius:12px;background:linear-gradient(100deg,#70a5ff,#53e5ce,#70a5ff);background-size:220% 100%;animation:buttonFlow 5s linear infinite;font-size:16px;font-weight:bold;cursor:pointer;transition:transform .25s,filter .25s;box-shadow:0 6px 18px #0003}
button:hover{filter:brightness(1.08);transform:scale(1.02)}
.modal{display:none;position:fixed;inset:0;background:#020817eF;z-index:1000;padding:16px;align-items:center;justify-content:center;overflow-y:auto}
.modal.open{display:flex}
.modal-card{width:min(440px,100%);max-height:94vh;overflow-y:auto;background:linear-gradient(145deg,#1b2d50,#101a33);border:1px solid #6c8cff;border-radius:24px;padding:22px;text-align:center;box-shadow:0 25px 80px #000b;animation:pop .35s ease,modalGlow 4s ease-in-out infinite}
.modal-card h2{margin:8px 0 12px}
.qr{width:100%;max-width:270px;background:#fff;padding:9px;border-radius:14px;animation:qrFloat 4s ease-in-out infinite;box-shadow:0 10px 28px #0004}
.big{font-size:30px;font-weight:900;color:#70e9ff}
input{width:100%;padding:14px;margin:9px 0;border-radius:10px;border:1px solid #7190bb;background:#0c1932;color:#fff;font-size:16px}
.close{background:#34476e;color:white;margin-top:10px}
.note{color:#bac9e4;font-size:12px;line-height:1.5}
@keyframes show{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
@keyframes bgShift{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
@keyframes titleGlow{to{background-position:250% center}}
@keyframes buttonFlow{to{background-position:220% center}}
@keyframes modalGlow{0%,100%{box-shadow:0 25px 80px #000b,0 0 8px #6c8cff22}50%{box-shadow:0 25px 80px #000b,0 0 22px #53e5ce55}}
@keyframes qrFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes pop{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}

/* Features side button and panel */
.features-tab{
 animation:tabPulse 2.8s ease-in-out infinite;
 position:fixed;right:0;top:42%;z-index:900;
 width:auto;padding:15px 12px;border-radius:14px 0 0 14px;
 background:linear-gradient(180deg,#a78bfa,#53e5ce);
 color:#07152c;font-weight:900;letter-spacing:1px;
 box-shadow:0 8px 28px #0008;writing-mode:vertical-rl;
 transform:rotate(180deg);cursor:pointer
}
.features-overlay{
 display:none;position:fixed;inset:0;z-index:1100;
 background:#020817ed;padding:18px;overflow-y:auto;
 align-items:center;justify-content:center
}
.features-overlay.open{display:flex}
.features-panel{
 width:min(760px,100%);max-height:92vh;overflow-y:auto;
 background:linear-gradient(145deg,#172d52,#0b142b);
 border:1px solid #70dfff;border-radius:24px;padding:clamp(20px,4vw,36px);
 box-shadow:0 25px 80px #000b;text-align:center
}
.features-panel h2{
 margin:0 0 8px;font-size:clamp(30px,6vw,48px);
 color:#70e9ff;text-transform:uppercase
}
.features-subtitle{color:#c5d2ed;font-size:17px;margin-bottom:24px}
.feature-item{
 margin:14px 0;padding:20px 16px;border-radius:17px;
 background:linear-gradient(110deg,#233d67,#172747);
 border:1px solid #47628e
}
.feature-item strong{
 display:block;font-size:clamp(21px,4vw,30px);
 line-height:1.25;color:#fff
}
.feature-item span{display:block;color:#aeeeff;font-size:15px;margin-top:7px}
.features-close{margin-top:18px;background:linear-gradient(90deg,#70a5ff,#53e5ce);color:#07152c}
@keyframes tabPulse{0%,100%{box-shadow:0 8px 28px #0008}50%{box-shadow:0 8px 32px #53e5ce88,0 0 16px #a78bfa66}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
@media(max-width:480px){
 .features-tab{top:38%;padding:13px 10px;font-size:13px}
 .features-panel{padding:20px 14px}
 .feature-item{padding:17px 12px}
}

</style>
</head>
<body>
<header>
<h1>🎓 Educational Store</h1>
<p>Learn More • Grow More 🚀</p>
</header>

<div class="container">
<div class="grid" id="apps"></div>
</div>


<button class="features-tab" type="button" onclick="openFeatures()" aria-controls="featuresPanel">
 ✨ FEATURES
</button>

<div class="features-overlay" id="featuresPanel" role="dialog" aria-modal="true" aria-labelledby="featuresTitle">
 <section class="features-panel">
  <h2 id="featuresTitle">✨ Store Features</h2>
  <p class="features-subtitle">Your learning, all in one place 📚</p>

  <div class="feature-item">
   <strong>📱 ALL APPS</strong>
   <span>Explore the educational apps available in our store.</span>
  </div>
  <div class="feature-item">
   <strong>🔓 ALL BATCHES UNLOCKED</strong>
   <span>Latest and older batches, where access is authorized and included.</span>
  </div>
  <div class="feature-item">
   <strong>🎥 LIVE CLASSES</strong>
   <span>Live class access wherever it is provided with the selected course.</span>
  </div>
  <div class="feature-item">
   <strong>📝 TESTS & PRACTICE</strong>
   <span>Practice tests and assessments included with eligible batches.</span>
  </div>
  <div class="feature-item">
   <strong>♾️ LIFETIME ACCESS</strong>
   <span>Lifetime access only for content explicitly covered by the purchase terms.</span>
  </div>

  <button class="features-close" type="button" onclick="closeFeatures()">CLOSE ✕</button>
 </section>
</div>

<!-- Buy button opens this payment window in the center of the screen -->
<div class="modal" id="paymentModal" role="dialog" aria-modal="true" aria-labelledby="paymentTitle">
 <div class="modal-card">
  <h2 id="paymentTitle">💳 COMPLETE PAYMENT</h2>
  <p id="productName"></p>
  <div class="big">PAY ₹60</div>
  <p>SCAN THE QR CODE BELOW</p>
  <img src="data:image/jpeg;base64," class="qr" alt="Payment QR Code">
  <h2>COMPLETE PAYMENT</h2>
  <div class="big">ENTER TRANSACTION ID</div>
  <input id="txn" maxlength="80" placeholder="Enter Transaction ID">
  <input id="buyer" maxlength="60" placeholder="Your Name (optional)">
  <button onclick="verify()">VERIFY</button>
  <p class="note" id="message" aria-live="polite"></p>
  
  <button class="close" onclick="closePayment()">CLOSE</button>
 </div>
</div>

<script>
const appList=[
 {name:"PW",icon:'https://play-lh.googleusercontent.com/2PisL-eEF56tavzVU7P5i-dmeZUX7SFVWMWhhSHFgiz1rEXCtImtMMReufn-OghK341U9NLhIjaCQfdK6A-bpRo'},
 {name:"Unacademy",icon:'https://play-lh.googleusercontent.com/TuO8x2M7UjGKZ2XLbtSBkAP9UV53dTFtBpzzkDEEPepNGwzQffDXVujee64PJt9BiE5jFp5v3_NqsRUpkATp0D8'},
 {name:"RWA",icon:'https://play-lh.googleusercontent.com/gWz-XO7Lb_kWL9ctOCRz5xiu9agActAhDgDBZZ4QQK372HDod6fPqV_WfcoYaDZkRA5x0chY1bHWdQukBRAM'},
 {name:"Textbook",icon:null},
 {name:"Careerwill",icon:'https://play-lh.googleusercontent.com/GuXFo6caz9vT2xBqMrPNQ7pB3KOk9qE9dxrbz42VAjjl8EywFlmJD0-NXAcvvr7Br1Va_NtXuwiztlkxpK5KVA'},
 {name:"KGS",icon:'https://play-lh.googleusercontent.com/57kzPUr7GvTJHgqzUpiOw_fLwldAiuPVbPBbqiFA81U1jEcohJ0MfRzY86Q2rqYSHrHC-eG7DG7sGGMxrB35wQ'},
 {name:"Next Topper",icon:'https://play-lh.googleusercontent.com/QXszaiUECWDTaY9IMT-Ligsh8xcRRjyTXefomzW98SM5aftooi0KOv_7O0uzem8cYhyFWBiGpIrfC_zDddbz2g'}
];
const apps=document.getElementById("apps");
appList.forEach(app=>{
 const card=document.createElement("div");
 card.className="card";
 card.style.animationDelay=(apps.children.length*70)+"ms";
 const logo=document.createElement("div");
 if(app.icon){
   const img=document.createElement("img");
   img.className="logo";
   img.src=app.icon+"=w160-h160";
   img.alt=app.name+" official Google Play app icon";
   logo.appendChild(img);
 }else{
   logo.className="logo";
   logo.style.display="grid";
   logo.style.placeItems="center";
   logo.style.fontSize="34px";
   logo.textContent="📚";
   logo.setAttribute("aria-label","Textbook icon");
 }
 const title=document.createElement("h2");title.textContent=app.name;
 const price=document.createElement("div");price.className="price";price.textContent="₹60";
 const button=document.createElement("button");button.textContent="BUY NOW 🛒";
 button.addEventListener("click",()=>buy(app.name));
 card.append(logo,title,price,button);apps.appendChild(card);
});

function openFeatures(){
 document.getElementById("featuresPanel").classList.add("open");
 document.body.style.overflow="hidden";
}
function closeFeatures(){
 document.getElementById("featuresPanel").classList.remove("open");
 document.body.style.overflow="";
}
document.getElementById("featuresPanel").addEventListener("click",e=>{
 if(e.target.id==="featuresPanel")closeFeatures();
});

let selectedProduct="";
let verifyAttempts=0;
const pwAppLink="https://studyhulk.vercel.app/";
function buy(name){
 verifyAttempts=0;
 selectedProduct=name;
 document.getElementById("productName").textContent="Selected Product: "+name+" | ₹60";
 document.getElementById("txn").value="";
 document.getElementById("buyer").value="";
 document.getElementById("message").textContent="";
 document.getElementById("paymentModal").classList.add("open");
 document.body.style.overflow="hidden";
}
function closePayment(){
 document.getElementById("paymentModal").classList.remove("open");
 document.body.style.overflow="";
}
function verify(){
 const message=document.getElementById("message");
 if(!selectedProduct){message.textContent="Please select a product first.";return;}
 verifyAttempts++;
 if(verifyAttempts < 5){
  message.textContent="Transaction ID not verified. Please check the details.";
  return;
 }
 message.textContent="Opening the StudyHulk website. Payment has not been verified.";
 const oldLink=document.getElementById("pwUnlockLink");
 if(oldLink)oldLink.remove();
 const link=document.createElement("a");
 link.id="pwUnlockLink";
 link.href=pwAppLink;
 link.target="_blank";
 link.rel="noopener noreferrer";
 link.textContent="OPEN STUDYHULK WEBSITE";
 link.style.cssText="display:inline-block;margin:12px 0;padding:12px 18px;background:#16a34a;color:#fff;border-radius:8px;text-decoration:none;font-weight:700";
 message.appendChild(document.createElement("br"));
 message.appendChild(link);
 const opened = window.open(pwAppLink, "_blank", "noopener,noreferrer");
 if (!opened) message.appendChild(document.createTextNode(" (If the website does not open automatically, use the link above.)"));
}

document.getElementById("paymentModal").addEventListener("click",e=>{
 if(e.target.id==="paymentModal")closePayment();
});
document.addEventListener("keydown",e=>{if(e.key==="Escape")closePayment();});
</script>
</body>
</html>
